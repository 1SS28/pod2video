# Magic Hour: https://magichour.ai/developer?tab=api-keys
MAGIC_HOUR_API_KEY=

# Transcription with word timestamps + speaker labels: assemblyai (default) or deepgram
TRANSCRIPTION_PROVIDER=assemblyai
TRANSCRIPTION_API_KEY=
# Optional: price per audio hour for the report (defaults: assemblyai 0.23, deepgram 0.258)
TRANSCRIPTION_USD_PER_HOUR=

# Moment selection. Provider is inferred from the model id (claude-* = Anthropic, otherwise OpenAI).
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5
# Reasoning effort for moment selection (low|medium|high|xhigh|max). Picking moments well is cheap
# insurance for the expensive render step. Also set prices for models not in core/llm.py.
LLM_EFFORT=high
LLM_USD_PER_MTOK_IN=
LLM_USD_PER_MTOK_OUT=

# Pricing for cost reports: auto reads your plan from your Magic Hour account.
# Or set one of: creator-monthly, creator-annual, pro-monthly, pro-annual, business-monthly,
# business-annual, pack, usage-creator, usage-pro, usage-business (see `pod2video plans`).
MAGIC_HOUR_PLAN=auto
# Optional exact override, e.g. with a negotiated discount
MAGIC_HOUR_CREDITS_PER_USD=

# Optional: ffmpeg with libass (captions). Auto-detected, including Homebrew's ffmpeg-full.
# FFMPEG_BIN=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
